index=linux sourcetype=linux_secure earliest=-24h
("Invalid user" OR "Failed password" OR "Accepted publickey" OR "Accepted password")
| rex field=_raw "from (?<source_ip>\d{1,3}(?:\.\d{1,3}){3})"
| rex field=_raw "(?:Invalid user\s+|Failed password for (?:invalid user )?|Accepted (?:publickey|password) for )(?<username>\S+)"
| eval authentication_result=case(
    match(_raw,"Invalid user|Failed password"),"failure",
    match(_raw,"Accepted publickey|Accepted password"),"success"
)
| stats count(eval(authentication_result="failure")) AS failures
        count(eval(authentication_result="success")) AS successes
        earliest(eval(if(authentication_result="failure",_time,null()))) AS first_failure
        latest(eval(if(authentication_result="success",_time,null()))) AS last_success
        values(username) AS users
        BY source_ip host
| where isnotnull(source_ip)
        AND failures>=3
        AND successes>=1
        AND last_success>first_failure
| eval detection_id="DET-010",
       detection="Successful SSH Login Following Multiple Failures",
       severity="HIGH",
       mitre_technique="T1110"
| convert ctime(first_failure) ctime(last_success)
| table detection_id detection severity source_ip host failures successes first_failure last_success users mitre_technique
| sort -last_success
