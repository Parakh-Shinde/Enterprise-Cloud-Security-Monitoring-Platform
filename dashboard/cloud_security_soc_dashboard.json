{
    "title": "Enterprise Cloud Security SOC Command Center",
    "description": "Real-time AWS cloud, network, authentication and web security monitoring dashboard.",
    "inputs": {
        "input_global_trp": {
            "options": {
                "defaultValue": "-24h@h,now",
                "token": "global_time"
            },
            "title": "Investigation Time Range",
            "type": "input.timerange"
        }
    },
    "defaults": {
        "dataSources": {
            "ds.search": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            },
            "ds.spl2": {
                "options": {
                    "queryParameters": {
                        "earliest": "$global_time.earliest$",
                        "latest": "$global_time.latest$"
                    }
                }
            }
        },
        "visualizations": {
            "global": {
                "showProgressBar": true
            }
        }
    },
    "visualizations": {
        "viz_3XWtSUCr": {
            "context": {
                "healthColumnFormatEditorConfig": {
                    "string": {
                        "unitPosition": "after"
                    }
                },
                "healthRowBackgroundColorsEditorConfig": [
                    {
                        "match": "DELAYED",
                        "value": "#FE3A3A"
                    },
                    {
                        "match": "STALE",
                        "value": "#ffd442"
                    },
                    {
                        "match": "Healthy",
                        "value": "#C3CC33"
                    }
                ],
                "healthRowColorsEditorConfig": [
                    "#53a051"
                ]
            },
            "dataSources": {
                "primary": "ds_n916j8Ug"
            },
            "options": {
                "columnFormat": {
                    "health": {
                        "align": "auto",
                        "data": "> table | seriesByName(\"health\") | formatByType(healthColumnFormatEditorConfig)",
                        "headerAlign": "auto",
                        "rowBackgroundColors": "> table | seriesByName(\"health\") | matchValue(healthRowBackgroundColorsEditorConfig)",
                        "rowColors": "> table | seriesByName(\"health\") | pick(healthRowColorsEditorConfig)",
                        "textOverflow": "break-word"
                    }
                },
                "count": 20,
                "tableFormat": {
                    "headerAlign": "center"
                }
            },
            "title": "Log Source Health",
            "type": "splunk.table"
        },
        "viz_EVkq7hSY": {
            "containerOptions": {},
            "context": {
                "majorColorEditorConfig": [
                    {
                        "to": 20,
                        "value": "#D41F1F"
                    },
                    {
                        "from": 20,
                        "to": 40,
