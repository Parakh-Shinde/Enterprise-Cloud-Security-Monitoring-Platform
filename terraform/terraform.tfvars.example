project_name = "enterprise-cloud-security-soc"
environment  = "lab"
aws_region   = "ap-south-1"

# Replace with your current trusted public IP in /32 notation.
# 203.0.113.0/24 is reserved for documentation and will not grant real access.
admin_cidr = "203.0.113.10/32"

# Optional existing EC2 key-pair name. Set null if using another administration method.
key_name = "replace-with-your-key-pair"

web_instance_type  = "t3.micro"
siem_instance_type = "t3.small"

log_retention_days               = 30
cloudtrail_object_retention_days = 90

extra_tags = {
  Owner      = "SecurityEngineering"
  CostCenter = "TrainingLab"
}
